{
  "name": "beril-theme",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Page frame for the BERIL Knowledge Wiki: record header, evidence rail, topic map.",
  "license": "AGPL-3.0-or-later",
  "exports": {
    ".": "./dist/index.js",
    "./frames": "./dist/frames.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "esbuild src/index.ts src/frames.tsx --bundle --format=esm --platform=node --target=node22 --external:preact --external:preact/* --jsx=automatic --jsx-import-source=preact --outdir=dist",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@quartz-community/types": "^0.3.0",
    "@quartz-community/utils": "^0.1.1",
    "@types/hast": "^3.0.4",
    "esbuild": "^0.25.0",
    "github-slugger": "^2.0.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "typescript": "^5.6.0"
  },
  "quartz": {
    "name": "beril-theme",
    "displayName": "BERIL theme",
    "description": "Record-card page frame with an evidence rail and a topic map.",
    "version": "0.1.0",
    "category": "component",
    "frames": {
      "BerilFrame": {
        "exportName": "BerilFrame"
      }
    }
  }
}
