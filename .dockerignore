# The image needs only the built site and corpus, the server modules and the
# lock that pins their dependencies (see Dockerfile). Everything else stays out
# of the context, which otherwise carries wiki/, quartz/node_modules and .git.
*
!pyproject.toml
!uv.lock
!src/beril_wiki/__init__.py
!src/beril_wiki/serve.py
!src/beril_wiki/wiki_api.py
!src/beril_wiki/publish/__init__.py
!src/beril_wiki/publish/artifact.py
!quartz/public/
!quartz/corpus/
