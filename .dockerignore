# Build context for the Dockerfile. The runtime stage needs only the server
# modules, the lock and (for SITE_FROM=hostsite) the host-built site; the
# in-image site build (SITE_FROM=site) also needs the sources it renders from.
# .git, .venv, quartz/node_modules and the quartz clone itself stay out.
*
!pyproject.toml
!uv.lock
!src/
!theme/
!scripts/
!contract/
!state/
!wiki/
!corpus/
!search/section-vectors.jsonl
!quartz/public/
!quartz/corpus/
theme/node_modules/
theme/dist/
**/__pycache__/
**/.DS_Store
